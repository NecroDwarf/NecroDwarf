      "tag": "h2",
      "children": ["ui.capture_pointer"],
      "props": { "id": "uicapture_pointer" }
    },
    {
      "tag": "p",
      "children": [
        "Перенаправить текущую последовательность указателя своему узлу."
      ]
    },
