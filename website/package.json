{
  "name": "necrodwarf-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run search:prepare",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run docs:novellmaker && npm run search:prepare && npm run typecheck && node scripts/build.mjs",
    "search:prepare": "node scripts/prepare-wiki-search.mjs",
    "check:search": "node scripts/check-wiki-search.mjs",
    "docs:novellmaker": "node scripts/prepare-novellmaker.mjs",
    "docs:novellmaker:sync": "node scripts/sync-novellmaker.mjs",
    "check:novellmaker": "node scripts/check-novellmaker.mjs",
    "check:novellmaker:browser": "node scripts/check-novellmaker-browser.mjs",
    "check": "node scripts/check-build.mjs && node scripts/check-project-content.mjs && node scripts/check-maniac-wiki.mjs && node scripts/check-maniac-chronicles.mjs && node scripts/check-maniac-characters.mjs && node scripts/check-maniac-icons.mjs && node scripts/check-maniac-reference.mjs && node scripts/check-maniac-systems.mjs && node scripts/check-maniac-maps.mjs && npm run check:catalogs && npm run check:effects && npm run check:stats && npm run check:editorial && npm run check:loading && npm run check:search && node scripts/check-wiki-placement.mjs && npm run check:novellmaker",
    "check:stats": "node scripts/check-maniac-stats.mjs",
    "check:effects": "node scripts/check-maniac-effects.mjs",
    "check:catalogs": "node scripts/check-maniac-catalog-groups.mjs",
    "check:maps:browser": "node scripts/check-maniac-maps-browser.mjs",
    "check:systems:browser": "node scripts/check-maniac-systems-browser.mjs",
    "check:reference:browser": "node scripts/check-maniac-reference-browser.mjs",
    "check:wiki:browser": "node scripts/check-maniac-wiki-browser.mjs",
    "check:navigation:browser": "node scripts/check-navigation-browser.mjs",
    "check:browser": "npm run check:wiki:browser && npm run check:reference:browser && npm run check:systems:browser && npm run check:maps:browser && npm run check:navigation:browser && npm run check:search:browser && npm run check:hydration:browser && npm run check:friendsheep:browser && npm run check:novellmaker:browser",
    "check:friendsheep:browser": "node scripts/check-friendsheep-browser.mjs",
    "check:search:browser": "node scripts/check-wiki-search-browser.mjs",
    "check:hydration:browser": "node scripts/check-hydration-browser.mjs",
    "check:release:browser": "node scripts/check-release-candidate.mjs && node scripts/check-release-journeys.mjs",
    "browser:install": "playwright install chromium",
    "check:loading": "node scripts/check-route-loading.mjs",
    "measure:loading": "node scripts/measure-loading.mjs",
    "preview": "node scripts/serve.mjs",
    "dev:maniac": "node scripts/maniac-preview.mjs",
    "build:maniac-preview": "node scripts/maniac-preview.mjs build",
    "preview:maniac": "node scripts/maniac-preview.mjs serve",
    "assets:maniac": "node scripts/convert-maniac-model.mjs",
    "assets:maniac:item": "node scripts/prepare-maniac-item.mjs",
    "assets:maniac:render": "node scripts/render-maniac-item.mjs",
    "dev:prototypes": "node scripts/prototypes.mjs",
    "format:check": "prettier --check src/app src/main.tsx src/entry-server.tsx scripts/*.mjs index.html prototypes.html package.json",
    "check:editorial": "node scripts/check-wiki-editorial.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "7.18.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.186.0",
    "highlight.js": "^11.12.0",
    "marked": "^17.0.6",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
